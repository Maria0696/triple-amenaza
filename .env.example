# Dominio público de la web, sin barra final. Se usa en las vistas previas al compartir (Open Graph).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.es

# Copia este archivo a .env.local y sustituye los valores por los de tu proyecto Firebase.
# Estos valores identifican la configuración PUBLICA de una aplicación Firebase web.
# Los permisos de datos se protegen con Firebase Authentication + reglas Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
